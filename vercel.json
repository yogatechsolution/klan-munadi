{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "installCommand": "echo 'Skip npm install (CSS/JS sudah siap di public/assets)'",
    "buildCommand": "echo 'Skip vite build'",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "^/assets/(.*)$",
            "dest": "/assets/$1"
        },
        {
            "src": "^/favicon\\.ico$",
            "dest": "/favicon.ico"
        },
        {
            "src": "^/robots\\.txt$",
            "dest": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Klan Kasan Munadi",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "pgsql",
        "DB_PORT": "5432",
        "DB_SSLMODE": "require",
        "CLOUDINARY_FOLDER": "klan-munadi",
        "ADMIN_USERNAME": "admin"
    }
}
